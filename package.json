{
  "name": "fiexea-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FIEXEA Android and iOS development builds",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "mobile:build": "node scripts/build-mobile.mjs",
    "mobile:sync": "npm run mobile:build && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "mobile:check": "node scripts/check-mobile.mjs",
    "mobile:release-check": "node scripts/check-mobile.mjs --release"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@supabase/supabase-js": "2.117.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "esbuild": "0.28.2"
  }
}
